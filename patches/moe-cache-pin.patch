diff --git a/src/llama-impl.h b/src/llama-impl.h
index 884dca6..87de240 100644
--- a/src/llama-impl.h
+++ b/src/llama-impl.h
@@ -109,3 +109,22 @@ std::string llama_format_tensor_shape(const struct ggml_tensor * t);
 
 // arrays are rendered only until the result is longer than max_len
 std::string gguf_kv_to_str(const struct gguf_context * ctx_gguf, int i, size_t max_len = SIZE_MAX);
+
+// fopen with this library's own C runtime: a FILE * from ggml_fopen belongs to ggml's C runtime, which can differ
+// when llama is built with another toolchain than the ggml backends it loads (e.g. MinGW llama + prebuilt CUDA ggml)
+#include <cstdio>
+#if defined(_WIN32)
+#include <string>
+#include <windows.h>
+static inline FILE * llama_fopen_local(const char * fname, const char * mode) {
+    auto wide = [](const char * s) {
+        int n = MultiByteToWideChar(CP_UTF8, 0, s, -1, nullptr, 0);
+        std::wstring w(n > 0 ? n - 1 : 0, L'\0');
+        if (n > 0) { MultiByteToWideChar(CP_UTF8, 0, s, -1, w.data(), n); }
+        return w;
+    };
+    return _wfopen(wide(fname).c_str(), wide(mode).c_str());
+}
+#else
+static inline FILE * llama_fopen_local(const char * fname, const char * mode) { return fopen(fname, mode); }
+#endif
